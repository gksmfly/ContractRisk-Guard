# .env.example — `cp .env.example .env` 후 값을 채운다.
# 서버가 기동 시 검사하는 목록은 backend/api/server.py의 _REQUIRED_ENV_VARS 와 같아야 한다.

# ── 서버 기동에 반드시 필요 (없으면 이름을 찍고 기동 거부) ──────────────
OPENAI_API_KEY=sk-...
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contractrisk
# FORWARD_MODEL은 라벨링 전용이 아니다 — Analysis 단계가 run_forward()를 재사용하므로
# 서빙 import 체인이 fb_check/forward_labeling.py를 지난다.
#
# ★ 이 값은 **서빙용**이다. 라벨링(backend.fb_check)에 mini를 쓰면 안 된다 —
#   9유형 분류에서 빈 배열 66%(gpt-4o는 39%)로 부적합 확정이다(2026-08-23 실측).
#   라벨링은 `--model gpt-4o`로 매번 명시한다. env 기본값을 상속하지 않는다.
FORWARD_MODEL=gpt-4o-mini

# ── 오프라인 파이프라인(fb_check / training / eval) 전용 ────────────────
VERIFY_MODEL=gpt-4o-mini
HF_TOKEN=
# EXAONE_ENABLED= 는 두지 않는다 — 법령 라우팅을 상수 스코핑(약관규제법 제6~14조)으로
# 바꾸면서 읽는 곳이 사라졌다. 있으면 동작하는 것처럼 읽힌다.

# ── 선택 (기본값이 있으므로 비워도 동작) ────────────────────────────────
# API_KEY=                      # 설정 시 API 인증 활성화
# MODEL_DIR=models/article_v2   # 판단 모델 체크포인트. v1로 되돌리려면 models/article_v1
# JUDGMENT_DEVICE=cuda:1        # 프로젝트 규칙상 GPU는 cuda:1 고정
# MAX_CLAUSES=60                # 조항 분리 상한. 초과분은 응답에 개수로 보고
# MAX_CONCURRENT_ANALYSES=4     # 동시 분석 요청 수
