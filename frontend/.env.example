# frontend/.env.example
# 로컬 개발: cp .env.example .env.local 후 값 채우기

# backend/api(FastAPI) 서버 주소. 미설정 시 http://localhost:8000 사용.
FASTAPI_URL=http://localhost:8000

# backend/.env의 API_KEY와 동일한 값을 넣으면 FastAPI 쪽 인증이 활성화된다.
# 비워두면(기본값) 백엔드가 인증을 건너뛴다 — 로컬 개발용. 배포 시에는 반드시 설정할 것.
# 서버 사이드 전용 값이므로 NEXT_PUBLIC_ 접두사를 붙이지 않는다(브라우저에 노출 금지).
BACKEND_API_KEY=

# --- Google 로그인 (NextAuth) ---

# backend와 동일한 Postgres. NextAuth의 @auth/pg-adapter가 users/accounts/
# sessions/verification_token 테이블(backend/db/migrations 참고)을 직접 읽고 쓴다.
DATABASE_URL=postgresql://contractrisk-guard-db:1234@localhost:5432/contractrisk-guard-db

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID(Web
# application)에서 발급. Authorized redirect URI에
# http://localhost:3000/api/auth/callback/google 를 등록해야 한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth 내부 서명/암호화용 랜덤 시크릿. `openssl rand -base64 32`로 생성.
NEXTAUTH_SECRET=
# 배포 시 실제 도메인으로 바꿀 것. 로컬 개발은 기본값(http://localhost:3000)이면 됨.
NEXTAUTH_URL=http://localhost:3000
