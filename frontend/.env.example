# frontend/.env.example
# 로컬 개발: cp .env.example .env.local 후 값 채우기

# backend/api(FastAPI) 서버 주소. 미설정 시 http://localhost:8000 사용.
FASTAPI_URL=http://localhost:8000

# backend/.env의 API_KEY와 동일한 값을 넣으면 FastAPI 쪽 인증이 활성화된다.
# 비워두면(기본값) 백엔드가 인증을 건너뛴다 — 로컬 개발용. 배포 시에는 반드시 설정할 것.
# 서버 사이드 전용 값이므로 NEXT_PUBLIC_ 접두사를 붙이지 않는다(브라우저에 노출 금지).
BACKEND_API_KEY=
